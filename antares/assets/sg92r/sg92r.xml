<!-- One Tower Pro SG92R hobby servo standing upright with a popsicle stick
     glued to its horn: a one-joint robot for antares' bench demo.

     The shaft is vertical, so gravity puts no torque on the joint and the
     stick's inertia plus the gear train's reflected rotor inertia
     (armature) is all the motor moves. The joint angle is the servo's own
     0..180 degree command range. Starting values are rough datasheet
     figures (stall torque 2.5 kg*cm = 0.245 N*m, 0.1 s per 60 degrees at
     4.8 V); calibration replaces them. -->
<mujoco model="sg92r">
  <option integrator="implicitfast" timestep="0.001"/>

  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
  </default>

  <asset>
    <material name="case" rgba="0.12 0.22 0.55 1"/>
    <material name="stick" rgba="0.85 0.72 0.50 1"/>
    <mesh name="case" file="case.stl"/>
    <mesh name="arm" file="arm.stl"/>
  </asset>

  <worldbody>
    <body name="case" pos="0 0 0.027">
      <geom class="visual" mesh="case" material="case"/>
      <body name="arm">
        <inertial pos="0.05 0 0.005" mass="0.0015" diaginertia="2e-8 1.7e-6 1.7e-6"/>
        <joint name="shaft" axis="0 0 1" range="0 3.14159265" damping="0.002" frictionloss="0.005"
               armature="0.0003"/>
        <geom class="visual" mesh="arm" material="stick"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="shaft" joint="shaft" kp="1.5" kv="0.02" forcerange="-0.245 0.245"
              ctrlrange="0 3.14159265"/>
  </actuator>
</mujoco>
